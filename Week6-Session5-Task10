import java.io.*;
import java.util.*;

class Result {

    // Manacher's algorithm on transformed string
    private static int[] manacher(int[] arr) {
        int n = arr.length;
        int[] radius = new int[n];

        int center = 0;
        int right = 0;

        for (int i = 0; i < n; i++) {

            if (i < right) {
                int mirror = 2 * center - i;
                radius[i] = Math.min(right - i, radius[mirror]);
            }

            while (i - radius[i] - 1 >= 0 &&
                   i + radius[i] + 1 < n &&
                   arr[i - radius[i] - 1] == arr[i + radius[i] + 1]) {
                radius[i]++;
            }

            if (i + radius[i] > right) {
                center = i;
                right = i + radius[i];
            }
        }

        return radius;
    }

    // Sparse Table for range maximum query
    static class SparseTable {

        int[][] table;
        int[] log;

        SparseTable(int[] arr) {
            int n = arr.length;

            log = new int[n + 1];

            for (int i = 2; i <= n; i++) {
                log[i] = log[i / 2] + 1;
            }

            int levels = log[n] + 1;

            table = new int[levels][n];

            System.arraycopy(arr, 0, table[0], 0, n);

            for (int j = 1; j < levels; j++) {
                int length = 1 << j;
                int half = length >> 1;

                for (int i = 0; i + length <= n; i++) {
                    table[j][i] = Math.max(
                            table[j - 1][i],
                            table[j - 1][i + half]
                    );
                }
            }
        }

        int query(int left, int right) {
            if (left > right) {
                return 0;
            }

            int length = right - left + 1;
            int k = log[length];

            return Math.max(
                    table[k][left],
                    table[k][right - (1 << k) + 1]
            );
        }
    }

    public static List<Integer> circularPalindromes(String s) {

        int n = s.length();

        /*
         * Duplicate the string:
         *
         * s = abcde
         * doubled = abcdeabcde
         */
        int doubledLength = 2 * n;

        /*
         * Transform:
         *
         * abc -> #a#b#c#
         *
         * Using -1 as separator.
         */
        int transformedLength = 2 * doubledLength + 1;
        int[] transformed = new int[transformedLength];

        Arrays.fill(transformed, -1);

        for (int i = 0; i < doubledLength; i++) {
            transformed[2 * i + 1] =
                    s.charAt(i % n) - 'a';
        }

        // Find palindrome radius at every position
        int[] radius = manacher(transformed);

        // RMQ over palindrome radii
        SparseTable rmq = new SparseTable(radius);

        List<Integer> answer = new ArrayList<>();

        /*
         * For every rotation:
         *
         * rotation 0 -> s[0 ... n-1]
         * rotation 1 -> s[1 ... n]
         * rotation 2 -> s[2 ... n+1]
         *
         * Binary search the maximum palindrome length.
         */
        for (int start = 0; start < n; start++) {

            int left = 2 * start + 1;
            int right = 2 * (start + n - 1) + 1;

            int low = 1;
            int high = n;
            int best = 1;

            while (low <= high) {

                int len = (low + high) / 2;

                /*
                 * A palindrome of length len has its center
                 * somewhere in this range.
                 */
                int centerLeft = left + len - 1;
                int centerRight = right - len + 1;

                if (centerLeft <= centerRight &&
                    rmq.query(centerLeft, centerRight) >= len) {

                    best = len;
                    low = len + 1;

                } else {
                    high = len - 1;
                }
            }

            answer.add(best);
        }

        return answer;
    }
}

public class Solution {

    public static void main(String[] args) throws IOException {

        BufferedReader br =
                new BufferedReader(new InputStreamReader(System.in));

        int n = Integer.parseInt(br.readLine().trim());

        String s = br.readLine().trim();

        List<Integer> result =
                Result.circularPalindromes(s);

        StringBuilder output = new StringBuilder();

        for (int value : result) {
            output.append(value).append('\n');
        }

        System.out.print(output);
    }
}
